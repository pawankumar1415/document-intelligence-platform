# ─────────────────────────────────────────────
# AI Narrative Search — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# Default LLM provider (openai | groq | azure_openai | ollama)
DEFAULT_LLM_PROVIDER=openai

# ── Embeddings ──────────────────────────────
EMBEDDING_BACKEND=huggingface_local
EMBEDDING_MODEL_ID=nomic-ai/nomic-embed-text-v1.5

# ── PostgreSQL + pgvector ───────────────────
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/ai_narrative
VECTOR_STORE_RESET_ON_MISMATCH=false

# ── OpenAI ──────────────────────────────────
OPENAI_ENABLED=true
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Groq ────────────────────────────────────
GROQ_ENABLED=true
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ── Ollama (local) ──────────────────────────
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:0.6b
OLLAMA_CHAT_TIMEOUT_SECONDS=90

# ── Azure OpenAI ────────────────────────────
AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21